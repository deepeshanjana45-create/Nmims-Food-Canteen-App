# Server Port (Render sets this automatically, but for local dev:)
PORT=5001

# SMTP Credentials for Email OTP
# For Gmail: Use your Gmail address and 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="NMIMS Canteen <no-reply@nmims.edu>"
